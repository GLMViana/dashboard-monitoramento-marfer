# Copie para .env (ou exporte as variáveis) e troque os valores.
PORT=3000
# URL pública do LiveKit (wss:// se estiver atrás de HTTPS)
LIVEKIT_URL=wss://livekit.seudominio.com
LIVEKIT_API_KEY=troque-esta-chave
LIVEKIT_API_SECRET=troque-este-segredo-com-32-caracteres-ou-mais
# Coloque TRUST_PROXY=1 se o app estiver atrás do Caddy (sem isso, o limite de login vale para todos juntos)
TRUST_PROXY=1
# Segredo para assinar as sessões (gere com: openssl rand -hex 32)
SESSION_SECRET=troque-por-um-valor-aleatorio
